{
  "name": "laidir-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Láidir mobile app: offline-first gym tracker (Expo / React Native)",
  "license": "MIT",
  "main": "expo-router/entry",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "expo:doctor": "expo-doctor",
    "bundle:android": "expo export --platform android --output-dir dist",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm expo:doctor",
    "build:dev": "npx eas-cli@27.10.0 build --platform android --profile development",
    "build:preview": "npx eas-cli@27.10.0 build --platform android --profile preview",
    "contract:sync": "node scripts/contract-sync.mjs"
  },
  "dependencies": {
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.20",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "expo-doctor": "^1.21.8",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.14",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  }
}
